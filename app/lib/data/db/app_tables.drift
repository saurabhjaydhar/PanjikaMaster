-- Device-only tables (spec §15.1). Not part of packs; owned by the user.

CREATE TABLE reminders (
  id             INTEGER PRIMARY KEY AUTOINCREMENT,
  target_kind    TEXT NOT NULL CHECK (target_kind IN ('observance', 'tithi')),
  target_id      TEXT NOT NULL,
  offset_minutes INTEGER NOT NULL DEFAULT 0,
  time_of_day    TEXT,                          -- 'HH:MM' local, NULL = relative to the event
  enabled        INTEGER NOT NULL DEFAULT 1 CHECK (enabled IN (0, 1)),
  created_at     TEXT NOT NULL
) STRICT AS ReminderRow;

CREATE TABLE settings (
  "key" TEXT PRIMARY KEY,                       -- keys listed in spec §15.1
  value TEXT NOT NULL
) STRICT AS SettingRow;

CREATE TABLE error_reports_queue (
  id         INTEGER PRIMARY KEY AUTOINCREMENT,
  payload    TEXT NOT NULL,                     -- JSON with only the fields in spec §15.3
  created_at TEXT NOT NULL
) STRICT AS QueuedErrorReportRow;

-- Observances whose dates changed in a correction (spec §18, T-603): Day detail and
-- festival screens label them "সংশোধিত / Corrected" for 7 days. Schema version 2.
CREATE TABLE observance_corrections (
  tradition     TEXT NOT NULL,
  observance_id TEXT NOT NULL,
  corrected_at  TEXT NOT NULL,                  -- ISO 8601 UTC, when the import ran
  PRIMARY KEY (tradition, observance_id)
) STRICT AS ObservanceCorrectionRow;
